<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="LM_HomeworkMasterPage_2027.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> -liad site</title>

    <asp:PlaceHolder runat="server">

    </asp:PlaceHolder>
    <style>
    body {width:auto; height:auto; margin:auto;
    direction:rtl;padding-top:132px}
        .divCenter {
            text-align: center;
        }
        

.mpHeader { border: 3px solid red; }
.mpFooter { width:100%; height:30px; border: 3px solid silver; width:20%; }
.myTable {text-align:center; border: 3px solid silver; background-color:lightcyan;margin-left: auto;
  margin-right: auto;}
.myImage{height: 132px; width:200px;}
.MyWelcomePage{ border: 3px solid silver;}
.page1Div{font-weight:bold; font-size:64px; height:80px;padding:20px}
.page2Div{font-weight:bold; font-size:32px; height:80px;padding:20px}
</style>
<script>

    function initialize() {
        localTimer();
        setInterval("localTimer()", 1000);
    }
 
    function localTimer() {
        var d = new Date();
        var d1 = d.toLocaleDateString('en-UK'); 
        var t1 = d.toLocaleTimeString();
        var dd = d1 + "<br />" + t1;
        document.getElementById("myClock").innerHTML = d1 + "<br />" + t1;
    }

</script>

</head>
<body onload="initialize()">
    <form runat="server">
     
        <table class="myTable">
            <tr> <td class="mpHeader">
                 </td>
                <td class="mpHeader">
                                  <div class="divCenter">
                    <img src="https://www.moriahvc.co.il/wp-content/uploads/2016/12/11314fie.jpg" class="myImage"/>
                </div>
                </td>

                <td class="mpHeader"><div id="myClock"></div></td> </tr>
      <tr>
       
          <td colspan="3"  class="MyWelcomePage">
                <div class="container body-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
          </td>
         
      </tr>
          <tr class="mpFooter">
<td class="mpFooter" style="text-align:right"> צד ימין <====== </td>
<td class="mpFooter" style="width:60%;" >  <div>
      <span><a href="Contact.aspx"> דף1</a></span>
      <span><a href="About.aspx"> דף2</a></span>
      
  </div></td>
<td class="mpFooter";">
<span>מספר משתמשים במערכת:  <%= Application["appCounter"].ToString() %> </span>



</td>
</tr>

        </table>
 
     
    </form>
    <asp:PlaceHolder runat="server">

    </asp:PlaceHolder>
</body>
</html>
